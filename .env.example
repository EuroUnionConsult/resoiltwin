ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://resoiltwin:change-me-locally@localhost:55433/resoiltwin
# Chave partilhada exigida por TODAS as rotas -- ler e escrever -- menos
# GET /api/v1/health, que a sonda de saude chama sem credencial nenhuma. As
# quatro rotas de documentacao (/docs, /openapi.json, /docs/oauth2-redirect,
# /redoc) tambem a pedem.
# Sem valor por omissao no codigo, e nunca com um valor real neste ficheiro:
# gera um por instalacao com
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deixar vazia nao abre a API -- fecha-a: tudo menos o /health responde 503.
# O nome ficou com "write" por ser o do segredo ja usado no deployment; ver o
# cabecalho de src/resoiltwin/api/auth.py.
WRITE_API_KEY=
# A porta da consola (/console), e so dela. Sao duas variaveis e nao uma: a
# autenticacao HTTP basica pede um par, e o par e conferido de uma so vez -- ver
# src/resoiltwin/api/console_auth.py.
# ⚠️ O que faltar aqui NAO fecha a API, ao contrario da WRITE_API_KEY acima:
# fecha a CONSOLA. Todas as rotas sob /console respondem 503 e nenhuma serve uma
# linha de dados; a API continua a responder pela chave de cima, e o /health
# continua aberto. E 503 e nao 401 porque nao ha credencial nenhuma que o
# navegador pudesse apresentar para o corrigir -- o servidor e que nao esta em
# condicoes. Ver o argumento em src/resoiltwin/config.py.
# O utilizador NAO e segredo -- o navegador mostra-o na caixa que pede as
# credenciais, e ele viaja em claro no mesmo cabecalho que a senha --, e por
# isso fica aqui com o mesmo valor que o codigo ja tem por omissao. A forca esta
# toda na senha.
# ⚠️ Deixar o utilizador VAZIO nao e o mesmo que apagar a linha: uma variavel
# vazia sobrepoe-se ao valor por omissao, e a consola fecha como se faltasse a
# senha (com o registo a culpar a senha).
# A senha nao tem valor por omissao em lado nenhum, e nunca leva um valor real
# neste ficheiro: gera uma por instalacao com
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONSOLE_USER=console
CONSOLE_PASSWORD=
# Preenchidos apenas na Fase B, e nunca com valores reais neste ficheiro:
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Climate Data Store (Fase C, meteorologia). A chave e o token PRIVATE-TOKEN
# da conta do CDS; nunca com valores reais neste ficheiro:
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
