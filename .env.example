ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://resoiltwin:change-me-locally@localhost:55433/resoiltwin
# Chave partilhada exigida por TODAS as rotas -- ler e escrever -- menos
# GET /api/v1/health, que a sonda de saude chama sem credencial nenhuma. As
# quatro rotas de documentacao (/docs, /openapi.json, /docs/oauth2-redirect,
# /redoc) tambem a pedem.
# Sem valor por omissao no codigo, e nunca com um valor real neste ficheiro:
# gera um por instalacao com
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deixar vazia nao abre a API -- fecha-a: tudo menos o /health responde 503.
# O nome ficou com "write" por ser o do segredo ja usado no deployment; ver o
# cabecalho de src/resoiltwin/api/auth.py.
WRITE_API_KEY=
# Preenchidos apenas na Fase B, e nunca com valores reais neste ficheiro:
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Climate Data Store (Fase C, meteorologia). A chave e o token PRIVATE-TOKEN
# da conta do CDS; nunca com valores reais neste ficheiro:
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
