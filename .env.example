ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://resoiltwin:change-me-locally@localhost:55433/resoiltwin
# Chave partilhada exigida pelas rotas que ESCREVEM. As de leitura, incluindo
# /health, nao pedem nada. Sem valor por omissao no codigo, e nunca com um
# valor real neste ficheiro: gera um por instalacao com
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deixar vazia nao abre as escritas -- fecha-as: respondem 503.
WRITE_API_KEY=
# Preenchidos apenas na Fase B, e nunca com valores reais neste ficheiro:
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Climate Data Store (Fase C, meteorologia). A chave e o token PRIVATE-TOKEN
# da conta do CDS; nunca com valores reais neste ficheiro:
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
